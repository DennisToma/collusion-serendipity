    81	def exact_summary(values):
    82	    # Enumerate every one of 5**5 ordered empirical block bootstrap samples.
    83	    values=list(map(Fraction,values));n=len(values)
    84	    means=sorted(sum(values[i] for i in inds)/n for inds in itertools.product(range(n),repeat=n))
