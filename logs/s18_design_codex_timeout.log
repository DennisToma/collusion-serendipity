    19	    path=Path('logs/s18_launch_preflight.json')
    20	    assert not path.exists(),'No second live launch'
    21	    assert not (Path('data/s18_workplace')/'config.json').exists(),'No prior dataset'
    22	    obj=dict(registration_commit=head,commit_time_client=ct,observed_remote_head=remote,observed_utc=stamp,
    23	             server_time_attested=False,sources={p:hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in SOURCES})
    24	    with path.open('x') as f:f.write(json.dumps(obj,indent=2)+'\n')
    25	    print('S18 registration observed remotely at local UTC '+stamp,flush=True)
    26	    sys.argv=['sim.workplace'];main()
