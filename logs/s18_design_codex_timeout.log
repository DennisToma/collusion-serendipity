   168	                return obj if obj is not None and set(obj['reviews'])==set(AGENTS)-{agent} and (partner or obj['note']=='') else None
   169	            result=checked_call(cache,system,user,run_id,t,agent,model,backend,parser,calls)
   170	            notes.append(dict(round=t,agent=agent,reasoning=result['reasoning']))
   171	            records.append(dict(id=agent,reviews=result['reviews'],public_message='',action='review'))
   172	            if partner:pending.append(dict(round=t+1,author=agent,text=result['note']))
