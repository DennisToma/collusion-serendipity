    97	    null = [sum(d*sign for d,sign in zip(numerators,signs))
    98	            for signs in itertools.product([-1,1],repeat=len(numerators))]
    99	    return dict(exact_signflip_p_upper=sum(v >= observed for v in null)/len(null),
   100	                exact_signflip_p_lower=sum(v <= observed for v in null)/len(null),
   101	                exact_signflip_p_two_sided=sum(abs(v) >= abs(observed) for v in null)/len(null))
