    15	def summarize(values, rng):
    16	    a = np.asarray(values, float)
    17	    means = a[rng.integers(len(a), size=(10000, len(a)))].mean(axis=1)
    18	    return dict(mean=float(a.mean()), ci95=np.quantile(means, [.025, .975]).tolist())
