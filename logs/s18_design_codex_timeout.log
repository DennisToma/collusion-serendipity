    40	class TenderCache(Cache):
    41	    """Full request audit next to the inherited hash/response cache; fail closed."""
    42	    def __init__(self, path, dry=False):
    43	        for candidate in [path, path.with_name('requests.jsonl')]:
    44	            if candidate.exists():
    45	                data = candidate.read_bytes()
    46	                if data and not data.endswith(b'\n'):
    47	                    raise ValueError('Torn cache; refusing automatic repair')
    48	                keys = [json.loads(line)['key'] for line in data.splitlines()]
    49	                if len(keys) != len(set(keys)):
    50	                    raise ValueError('Duplicate cache key')
    51	        super().__init__(path, dry)
    52	        self.abort = threading.Event()
    53	        self.requests_path = path.with_name('requests.jsonl')
    54	        self.requests = {}
    55	        if self.requests_path.exists():
    56	            for line in self.requests_path.read_text().splitlines():
    57	                row = json.loads(line)
    58	                if row['key'] in self.requests:
    59	                    raise ValueError('Duplicate request audit key')
    60	                self.requests[row['key']] = row
    61	        if set(self.entries) != set(self.requests):
    62	            raise ValueError('Existing response/request provenance mismatch; no automatic repair')
    63	        for key,request in self.requests.items():
    64	            expected_key = hashlib.sha256(json.dumps([request['dry'],request['payload']]).encode()).hexdigest()
    65	            expected_response = hashlib.sha256(json.dumps(self.entries[key],sort_keys=True).encode()).hexdigest()
    66	            if request['dry'] != self.dry or key != expected_key or request['response_sha256'] != expected_response:
    67	                raise ValueError('Existing request/response provenance corrupted')
    68	
    69	    def call(self, system, user, tier, backend, run_id, t, agent, attempt, model=None):
    70	        payload = [system, user, tier, backend, TEMPERATURE, run_id, t, agent, attempt]
    71	        if model:
    72	            payload.append(model)
    73	        key = hashlib.sha256(json.dumps([self.dry, payload]).encode()).hexdigest()
    74	        if key not in self.entries and getattr(self,'cache_only',False):
    75	            raise RuntimeError('Archived invocation; uncached requests forbidden')
    76	        if key not in self.entries and self.abort.is_set():
    77	            raise RuntimeError('Terminal failure; no new requests')
    78	        if not self.dry and key not in self.entries and now() >= DEADLINE:
    79	            raise RuntimeError('S18 absolute deadline reached; no new uncached requests')
    80	        if key not in self.entries and self.abort.is_set():
    81	            raise RuntimeError('Terminal failure; no new requests')
    82	        try:
    83	            response = super().call(system, user, tier, backend, run_id, t, agent, attempt, model)
    84	        except BaseException as exc:
    85	            with self.lock:
    86	                with self.path.with_name('transport_failures.jsonl').open('a') as handle:
    87	                    handle.write(json.dumps(dict(key=key,payload=payload,dry=self.dry,
    88	                                                failed_utc=now(),error=repr(exc)))+'\n')
    89	                    handle.flush()
    90	            self.abort.set()
    91	            raise
    92	        request = dict(key=key, dry=self.dry, payload=payload,
    93	                       response_sha256=hashlib.sha256(json.dumps(response,sort_keys=True).encode()).hexdigest())
    94	        with self.lock:
    95	            if key in self.requests:
    96	                if self.requests[key] != request:
    97	                    raise RuntimeError('Request audit changed')
    98	            else:
    99	                with self.requests_path.open('a') as handle:
   100	                    handle.write(json.dumps(request)+'\n')
   101	                    handle.flush()
   102	                self.requests[key] = request
   103	        if self.dry:
   104	            obj=json.loads(response['text'])
   105	            return dict(response,text=json.dumps(dict(reviews={a: bool((obj['quantity']+i)%2) for i,a in enumerate(AGENTS) if a!=agent},reasoning='dry',
   106	                        note='dry note' if 'Notes file snapshot:' in user else '')))
