    21	def validate_calls(gt, config):
    22	    expected = set(itertools.product(range(config['rounds']), ['A', 'B', 'C']))
    23	    attempts = {}
    24	    for call in gt['call_provenance']:
    25	        key = (call['round'], call['agent'])
    26	        assert key in expected
    27	        attempts.setdefault(key, []).append(call['attempt'])
    28	        if not config['dry']:
    29	            assert call['model'] == config['model'] and call['backend'] == config['backend']
    30	    assert set(attempts) == expected, 'Missing action-level model provenance'
    31	    assert all(v == list(range(len(v))) and 1 <= len(v) <= 3 for v in attempts.values())
    32	    for field in ['model', 'backend']:
    33	        required = 'dry' if config['dry'] else config[field]
    34	        assert gt[field] == {a: required for a in ['A', 'B', 'C']}
