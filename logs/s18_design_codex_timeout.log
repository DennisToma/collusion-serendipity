   204	def assert_cached_replay(directory, games, cfg):
   205	    """Prove every action/failed attempt came from its reconstructed cached request."""
   206	    import contextlib
   207	    import io
   208	    from unittest.mock import patch
   209	    raw = Path(directory)/'raw/responses.jsonl'
   210	    request_path = raw.with_name('requests.jsonl')
   211	    original_bytes = [p.read_bytes() for p in [raw, request_path]]
   212	    used = []
   213	    class ReplayCache(TenderCache):
   214	        def call(self, system, user, tier, backend, run_id, t, agent, attempt, model=None):
   215	            payload = [system,user,tier,backend,TEMPERATURE,run_id,t,agent,attempt]
   216	            if model: payload.append(model)
   217	            key = hashlib.sha256(json.dumps([self.dry,payload]).encode()).hexdigest()
   218	            if key not in self.entries: raise ValueError('Cache miss during replay')
   219	            used.append(key)
   220	            return super().call(system,user,tier,backend,run_id,t,agent,attempt,model)
   221	    with patch('sim.common.llm.chat',side_effect=AssertionError('Uncached live call forbidden')):
   222	        cache = ReplayCache(raw, dry=cfg['dry'])
   223	        for game in games:
   224	            gt = game['ground_truth']
   225	            with contextlib.redirect_stdout(io.StringIO()):
   226	                replay = run_game(gt['seed'],gt['condition'],cache,cfg['model'],cfg['backend'],10)
   227	            if replay['rows'] != game['rows']:
   228	                raise ValueError('Recorded actions disagree with cached responses')
   229	            a,b = dict(replay['ground_truth']),dict(gt)
   230	            for obj in [a,b]:
   231	                del obj['started_utc'];del obj['ended_utc']
   232	            if a != b:
   233	                raise ValueError('Recorded attempts/provenance/tables disagree with cached replay')
   234	    if len(used) != len(set(used)) or set(used) != set(cache.entries) or set(used) != set(cache.requests):
   235	        raise ValueError('Replay must consume every key exactly once')
   236	    if [p.read_bytes() for p in [raw, request_path]] != original_bytes:
   237	        raise ValueError('Replay changed the raw cache/request audit')
