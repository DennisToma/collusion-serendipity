    40	class TenderCache(Cache):
    41	    """Full request audit next to the inherited hash/response cache; fail closed."""
    42	    def __init__(self, path, dry=False):
    43	        for candidate in [path, path.with_name('requests.jsonl')]:
    44	            if candidate.exists():
    45	                data = candidate.read_bytes()
    46	                if data and not data.endswith(b'\n'):
    47	                    raise ValueError('Torn cache; refusing automatic repair')
    48	                keys = [json.loads(line)['key'] for line in data.splitlines()]
    49	                if len(keys) != len(set(keys)):
    50	                    raise ValueError('Duplicate cache key')
    51	        super().__init__(path, dry)
    52	        self.abort = threading.Event()
    53	        self.requests_path = path.with_name('requests.jsonl')
    54	        self.requests = {}
    55	        if self.requests_path.exists():
    56	            for line in self.requests_path.read_text().splitlines():
    57	                row = json.loads(line)
    58	                if row['key'] in self.requests:
    59	                    raise ValueError('Duplicate request audit key')
    60	                self.requests[row['key']] = row
    61	        if set(self.entries) != set(self.requests):
    62	            raise ValueError('Existing response/request provenance mismatch; no automatic repair')
    63	        for key,request in self.requests.items():
    64	            expected_key = hashlib.sha256(json.dumps([request['dry'],request['payload']]).encode()).hexdigest()
    65	            expected_response = hashlib.sha256(json.dumps(self.entries[key],sort_keys=True).encode()).hexdigest()
    66	            if request['dry'] != self.dry or key != expected_key or request['response_sha256'] != expected_response:
    67	                raise ValueError('Existing request/response provenance corrupted')
