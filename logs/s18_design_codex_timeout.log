   190	
   191	def chat(prompt, system=None, model=None, temperature=0.7, max_tokens=512, backend=None, retries=3,
   192	         tier="cheap"):
   193	    """prompt: str or list of {role, content}. backend: None=auto, or 'keyed'|'go'|'codex'.
   194	    tier="big" (auditors, judges, label verification) -> codex gpt-6.1-sol first (medium effort), falls back to luna — check r["model"] so auditor comparisons stay same-model.
   195	    tier="cheap" (simulated agents, paraphrasing) -> keyed -> Go -> codex gpt-6-luna.
   196	    backend="claude", model="claude-opus-5-5"|"claude-sonnet-5-5" -> Claude (cross-family auditor).
   197	    `model` is backend-specific; only pass it together with an explicit backend."""
   198	    msgs = _messages(prompt, system)
   199	    if tier == "big" and not backend:
   200	        backend, model = "codex", CODEX_BIG
   201	    order = [backend] if backend else ["keyed", "go", "codex"]
   202	    err = None
   203	    for attempt in range(retries):
   204	        for b in order:
   205	            try:
   206	                r = (_codex(msgs, model, temperature, max_tokens, "medium") if tier == "big"
   207	                     else BACKENDS[b](msgs, model, temperature, max_tokens))
   208	            except Exception as e:  # network / timeout / codex failure -> next backend
   209	                err = e
   210	                continue
   211	            if r is not None:
   212	                text, m = r
   213	                with open(LOG, "a") as f:
   214	                    f.write(json.dumps({"t": time.time(), "backend": b, "model": m,
   215	                                        "in_chars": sum(len(x["content"]) for x in msgs),
   216	                                        "out_chars": len(text)}) + "\n")
   217	                return {"text": text, "backend": b, "model": m}
   218	        time.sleep(5 * (attempt + 1))
   219	    raise RuntimeError(f"all LLM backends failed: {err}")
   220	
