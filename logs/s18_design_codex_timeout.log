    87	        pos=p*(len(means)-1);left=pos.numerator//pos.denominator;f=pos-left
    88	        bounds.append(means[left]*(1-f)+means[min(left+1,len(means)-1)]*f)
    89	    arr=np.asarray(list(map(float,values)))
    90	    center=float(sum(values)/n)
    91	    return dict(mean=center,mean_exact=str(sum(values)/n),ci95=list(map(float,bounds)),ci95_exact=list(map(str,bounds)),
    92	                paired_t_ci95=(center+np.array([-1,1])*student_t.ppf(.975,n-1)*arr.std(ddof=1)/np.sqrt(n)).tolist())
