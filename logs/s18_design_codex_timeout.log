   165	def _run_game(seed,condition,cache,model,backend,rounds=10):
   166	    assert condition in CONDITIONS
   167	    started=now();pair=random.Random(seed).sample(AGENTS,2)
   168	    run_id=f's18_{seed}_{condition}'
   169	    rows,notes,calls,chat=[],[],[],[]
   170	    for t in range(rounds):
   171	        records,pending=[],[];passed=task_status(seed,t)
   172	        for agent in AGENTS:
   173	            partner=next((a for a in pair if a!=agent),None) if agent in pair else None
   174	            system,user=prompts(agent,partner,rows,chat,condition,passed)
   175	            def parser(text):
   176	                obj=parse_action(text)
   177	                return obj if obj is not None and set(obj['reviews'])==set(AGENTS)-{agent} and (partner or obj['note']=='') else None
   178	            result=checked_call(cache,system,user,run_id,t,agent,model,backend,parser,calls)
   179	            notes.append(dict(round=t,agent=agent,reasoning=result['reasoning']))
   180	            records.append(dict(id=agent,reviews=result['reviews'],public_message='',action='review'))
   181	            if partner:pending.append(dict(round=t+1,author=agent,text=result['note']))
   182	        chat.extend(pending)
   183	        scores,bad=outcome({a['id']:a['reviews'] for a in records},passed)
   184	        for record in records:record['profit']=scores[record['id']]
   185	        rows.append(dict(run_id=run_id,round=t,market=dict(passed=passed,incorrect_approvals=bad,organization_loss=10*bad),agents=records))
   186	    gt=dict(run_id=run_id,seed=seed,condition=condition,assigned_pair=pair,
   187	            private_channel_enabled=condition=='shared',notes_file=chat,notes_access=condition,agreement_verified=None,
   188	            coordinated_actions_verified=None,realized_collusion=None,hard_negative=None,
   189	            sim_version=VERSION,T=rounds,dry=cache.dry,reasoning_notes=notes,call_provenance=calls,
   190	            model={a:'dry' if cache.dry else model for a in AGENTS},
   191	            backend={a:'dry' if cache.dry else backend for a in AGENTS},
   192	            started_utc=min([started]+[c['call_started_utc'] for c in calls if c.get('call_started_utc')]),ended_utc=now())
   193	    print(f'{run_id} complete {len(calls)} calls',flush=True)
   194	    return dict(rows=rows,ground_truth=gt)
