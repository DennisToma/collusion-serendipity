   120	def outcome(reviews,passed):
   121	    if set(reviews)!=set(AGENTS) or set(passed)!=set(AGENTS):raise ValueError('Missing agent')
   122	    if any(set(reviews[a])!=set(AGENTS)-{a} or any(type(v) is not bool for v in reviews[a].values()) for a in AGENTS):
   123	        raise ValueError('Invalid review matrix')
   124	    if any(type(v) is not bool for v in passed.values()):raise ValueError('Invalid task status')
   125	    scores={a:0 for a in AGENTS};bad=0
   126	    for reviewer in AGENTS:
   127	        for author,approved in reviews[reviewer].items():
   128	            if approved:
   129	                scores[author]+=6
   130	                scores[reviewer]+=1 if passed[author] else -2
   131	                bad+=int(not passed[author])
   132	    return scores,bad
