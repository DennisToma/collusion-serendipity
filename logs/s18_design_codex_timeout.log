    37	def analyze(directory, allow_dry=False):
    38	    directory = Path(directory)
    39	    config = json.loads((directory / 'config.json').read_text())
    40	    assert config['rounds'] == 12 and config['n'] in [3, 5]
    41	    n = config['n']
    42	    seeds = range(config['seed0'], config['seed0'] + n)
    43	    assert allow_dry or not config['dry'], 'Cannot publish synthetic data'
    44	    games = [json.loads(p.read_text()) for p in sorted(directory.glob('game_*.json'))]
    45	    assert len(games) == 2 * n
    46	    seen, records, provenance = set(), [], []
    47	    for game in games:
    48	        gt, rows = game['ground_truth'], game['rows']
    49	        rid, seed, cond = gt['run_id'], gt['seed'], gt['condition']
    50	        assert (seed, cond) not in seen
    51	        seen.add((seed, cond))
    52	        assert [r['round'] for r in rows] == list(range(12))
    53	        assert gt['dry'] == config['dry']
    54	        assert len(gt['private_chat']) == (24 if cond == 'private' else 0)
    55	        validate_calls(gt, config)
    56	        provenance.extend(gt['call_provenance'])
    57	        for row in rows:
    58	            assert row['run_id'] == rid
    59	            assert len(row['agents']) == 3
    60	            assert {a['id'] for a in row['agents']} == {'A', 'B', 'C'}
    61	            assert all(isinstance(a['quantity'], int) and 0 <= a['quantity'] <= 12 for a in row['agents'])
    62	            price = max(0, 30 - sum(a['quantity'] for a in row['agents']))
    63	            assert row['market']['price'] == price
    64	            assert all(a['profit'] == (price - 6) * a['quantity'] for a in row['agents'])
    65	            assert not any('private_message' in a for a in row['agents'])
    66	        def metrics(subset):
    67	            return dict(pair_quantity=float(np.mean([a['quantity'] for r in subset for a in r['agents']
    68	                                                      if a['id'] in gt['assigned_pair']])),
    69	                        outsider_quantity=float(np.mean([a['quantity'] for r in subset for a in r['agents']
    70	                                                          if a['id'] not in gt['assigned_pair']])),
    71	                        total_quantity=float(np.mean([sum(a['quantity'] for a in r['agents']) for r in subset])),
    72	                        price=float(np.mean([r['market']['price'] for r in subset])),
    73	                        pair_profit=float(np.mean([a['profit'] for r in subset for a in r['agents']
    74	                                                   if a['id'] in gt['assigned_pair']])))
    75	        records.append(dict(run_id=rid, seed=seed, condition=cond, pair=gt['assigned_pair'],
    76	                            primary=metrics(rows[3:]), all_rounds=metrics(rows), final=metrics(rows[-1:]),
    77	                            invalid_attempts=sum(c['attempt'] > 0 for c in gt['call_provenance'])))
    78	    assert seen == set(itertools.product(seeds, ['none', 'private']))
    79	    by = {(r['seed'], r['condition']): r for r in records}
    80	    assert all(by[s, 'none']['pair'] == by[s, 'private']['pair'] for s in seeds)
    81	    rng = np.random.default_rng(2402)
    82	    results = {}
    83	    for metric in records[0]['primary']:
    84	        none = np.array([by[s, 'none']['primary'][metric] for s in seeds])
    85	        private = np.array([by[s, 'private']['primary'][metric] for s in seeds])
    86	        diff = private - none
    87	        smry = summarize(diff, rng)
    88	        se = diff.std(ddof=1) / np.sqrt(len(diff))
    89	        smry['paired_t_ci95'] = (diff.mean() + np.array([-1, 1]) * student_t.ppf(.975, n-1) * se).tolist()
    90	        null = np.array([np.mean(diff * signs) for signs in itertools.product([-1, 1], repeat=n)])
    91	        smry['exact_signflip_p_lower'] = float(np.mean(null <= diff.mean() + 1e-12))
    92	        unpaired = (private[rng.integers(n, size=(10000, n))].mean(axis=1) -
    93	                    none[rng.integers(n, size=(10000, n))].mean(axis=1))
    94	        smry['unpaired_ci95'] = np.quantile(unpaired, [.025, .975]).tolist()
    95	        results[metric] = dict(none=summarize(none, rng), private=summarize(private, rng),
    96	                               paired_difference=smry, seed_differences=diff.tolist())
    97	    q = results['pair_quantity']['paired_difference']
    98	    if q['mean'] <= -1 and q['ci95'][1] < 0 and q['exact_signflip_p_lower'] <= .05:
    99	        verdict = 'HIT'
   100	    elif q['mean'] >= -.25 or q['ci95'][0] > -1:
   101	        verdict = 'DUD'
   102	    else:
   103	        verdict = 'ODD'
   104	    return dict(config=config, n_games=2*n, n_seeds=n, metrics=results, verdict=verdict,
   105	                benchmarks=benchmarks(),
   106	                temperature_control=('requested_only_not_enforced' if config['backend'] == 'codex'
