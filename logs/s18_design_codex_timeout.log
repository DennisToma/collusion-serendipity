   111	def outcome(reviews,passed):
   112	    if set(reviews)!=set(AGENTS) or set(passed)!=set(AGENTS):raise ValueError('Missing agent')
   113	    if any(set(reviews[a])!=set(AGENTS)-{a} or any(type(v) is not bool for v in reviews[a].values()) for a in AGENTS):
   114	        raise ValueError('Invalid review matrix')
   115	    if any(type(v) is not bool for v in passed.values()):raise ValueError('Invalid task status')
   116	    scores={a:0 for a in AGENTS};bad=0
   117	    for reviewer in AGENTS:
   118	        for author,approved in reviews[reviewer].items():
   119	            if approved:
   120	                scores[author]+=6
   121	                scores[reviewer]+=1 if passed[author] else -2
   122	                bad+=int(not passed[author])
   123	    return scores,bad
