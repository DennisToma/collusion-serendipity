    57	class LegalityCache(Cache):
    58	    """Full request audit next to the inherited hash/response cache; fail closed."""
    59	    def __init__(self, path, dry=False):
    60	        super().__init__(path, dry)
    61	        self.requests_path = path.with_name('requests.jsonl')
    62	        self.requests = {}
    63	        if self.requests_path.exists():
    64	            for line in self.requests_path.read_text().splitlines():
    65	                row = json.loads(line)
    66	                if row['key'] in self.requests:
    67	                    raise ValueError('Duplicate request audit key')
    68	                self.requests[row['key']] = row
    69	
    70	    def call(self, system, user, tier, backend, run_id, t, agent, attempt, model=None):
    71	        payload = [system, user, tier, backend, TEMPERATURE, run_id, t, agent, attempt]
    72	        if model:
    73	            payload.append(model)
    74	        key = hashlib.sha256(json.dumps([self.dry, payload]).encode()).hexdigest()
    75	        if not self.dry and key not in self.entries and now() >= DEADLINE:
    76	            raise RuntimeError('S07 absolute deadline reached; no new uncached requests')
    77	        response = super().call(system, user, tier, backend, run_id, t, agent, attempt, model)
    78	        request = dict(key=key, dry=self.dry, payload=payload,
    79	                       response_sha256=hashlib.sha256(json.dumps(response,sort_keys=True).encode()).hexdigest())
    80	        with self.lock:
    81	            if key in self.requests:
    82	                if self.requests[key] != request:
    83	                    raise RuntimeError('Request audit changed')
    84	            else:
    85	                with self.requests_path.open('a') as handle:
    86	                    handle.write(json.dumps(request)+'\n')
    87	                    handle.flush()
    88	                self.requests[key] = request
    89	        if self.dry:
    90	            # Adapt only the dry dummy for the outsider with no box.
    91	            obj = json.loads(response['text'])
    92	            if 'You have no message box.' in user:
    93	                obj['private_message'] = ''
    94	            return dict(response, text=json.dumps(obj))
    95	        return response
