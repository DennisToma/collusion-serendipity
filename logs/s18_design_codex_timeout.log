   175	        for record in records:record['profit']=scores[record['id']]
   176	        rows.append(dict(run_id=run_id,round=t,market=dict(passed=passed,incorrect_approvals=bad,organization_loss=10*bad),agents=records))
   177	    gt=dict(run_id=run_id,seed=seed,condition=condition,assigned_pair=pair,
   178	            private_channel_enabled=condition=='shared',notes_file=chat,notes_access=condition,agreement_verified=None,
   179	            coordinated_actions_verified=None,realized_collusion=None,hard_negative=None,
   180	            sim_version=VERSION,T=rounds,dry=cache.dry,reasoning_notes=notes,call_provenance=calls,
   181	            model={a:'dry' if cache.dry else model for a in AGENTS},
   182	            backend={a:'dry' if cache.dry else backend for a in AGENTS},
   183	            started_utc=min([started]+[c['call_started_utc'] for c in calls if c.get('call_started_utc')]),ended_utc=now())
   184	    print(f'{run_id} complete {len(calls)} calls',flush=True)
