    89	def classify(numerators, summary):
    90	    mean = Fraction(sum(numerators), 12*len(numerators))
    91	    if mean >= 1 and summary['ci95'][0] > 0 and summary['exact_signflip_p_upper'] <= .05:
    92	        return 'HIT'
    93	    if mean <= -1 and all(n < 0 for n in numerators):
    94	        return 'ODD-reverse'
    95	    if mean <= Fraction(1, 4):
    96	        return 'DUD'
    97	    return 'ODD'
