    69	            response = dict(response, call_started_utc=called_utc,
    70	                            call_completed_utc=datetime.now(timezone.utc).isoformat())
    71	        with self.lock:
    72	            with self.path.open('a') as f:
    73	                f.write(json.dumps(dict(key=key, response=response)) + '\n')
