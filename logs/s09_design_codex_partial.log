    81	def exact_signflip(numerators):
    82	    observed = sum(numerators)
    83	    null = [sum(d*sign for d,sign in zip(numerators,signs))
    84	            for signs in itertools.product([-1,1],repeat=len(numerators))]
    85	    return dict(exact_signflip_p_upper=sum(v >= observed for v in null)/len(null),
    86	                exact_signflip_p_lower=sum(v <= observed for v in null)/len(null))
