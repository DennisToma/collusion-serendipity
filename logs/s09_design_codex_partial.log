    97	
    98	def _claude(msgs, model, temperature, max_tokens):
    99	    # Claude subscription (shared with the managers): use for cross-family auditing, not bulk sims.
   100	    sys_ = "\n".join(m["content"] for m in msgs if m["role"] == "system")
   101	    text = "\n\n".join(m["content"] for m in msgs if m["role"] != "system")
   102	    m = model or "claude-sonnet-5-5"
   103	    cmd = ["claude", "-p", text, "--model", m, "--output-format", "text", "--tools", ""]
   104	    if sys_:
   105	        cmd += ["--system-prompt", sys_]
   106	    r = subprocess.run(cmd, capture_output=True, text=True, timeout=600, check=True,
   107	                       cwd=tempfile.gettempdir(), stdin=subprocess.DEVNULL)
   108	    return r.stdout.strip(), m
   109	
   110	
   111	def _modal_post(url, key, body, timeout=900):
   112	    # Modal web endpoints answer requests running > ~150 s (e.g. GPU cold start) with 303 + Location;
   113	    # the result is fetched by GET on that Location (repeat while it keeps redirecting).
   114	    try:
   115	        return _post(url, key, body, timeout=timeout)
   116	    except urllib.error.HTTPError as e:
   117	        if e.code != 303:
   118	            raise
   119	        loc = e.headers["Location"]
   120	    deadline = time.time() + timeout
   121	    while time.time() < deadline:
   122	        req = urllib.request.Request(loc, headers={"Authorization": f"Bearer {key}"})
   123	        try:
   124	            d = json.load(urllib.request.urlopen(req, timeout=300))
   125	            return d["choices"][0]["message"].get("content") or ""
   126	        except urllib.error.HTTPError as e:
   127	            if e.code != 303:
   128	                raise
   129	            loc = e.headers["Location"]
   130	    raise TimeoutError("modal result not ready")
   131	
   132	
   133	def _qwen(msgs, model, temperature, max_tokens):
   134	    # Abliterated Qwen3.8-27B on Modal (QWEN_BASE_URL / QWEN_API_KEY in ~/collusion/compute.env).
   135	    # Explicit-only (backend="qwen"), never a silent fallback. Cold start after idle: up to ~10 min.
   136	    # Budget-capped: read ~/collusion/QWEN_BUDGET.txt before launching batches.
   137	    env = _env()
   138	    m = model or "qwen-abliterated"
   139	    body = {"model": m, "messages": msgs, "temperature": temperature, "max_tokens": max_tokens,
   140	            "chat_template_kwargs": {"enable_thinking": False}}
   141	    if m == "qwen-base":  # C3 control: base Qwen3.8-27B now via the Aqueduct gateway
   142	        return _aqueduct(msgs, "qwen-3.8-27b", temperature, max_tokens)[0], "qwen-base(aqueduct qwen-3.8-27b)"
   143	    url = {"qwen-abliterated": env["QWEN_BASE_URL"],  # extra Modal sellers (qwen_extra.py)
   144	           "qwen36-abliterated": "https://tomadennis1998--qwen-extra-qwen36-abliterated.us-east.modal.run",
   145	           "qwen9-abliterated": "https://tomadennis1998--qwen-extra-qwen9-abliterated.us-east.modal.run",
   146	           "qwen9-base": "https://tomadennis1998--qwen-extra-qwen9-base.us-east.modal.run"}[m]
   147	    return _modal_post(f"{url}/v1/chat/completions", env["QWEN_API_KEY"], body), m
   148	
   149	
   150	AQ_RATE = 45  # gateway limit is 50 req/min per key, shared by every process on the VM
   151	AQ_STATE = HOME / "collusion" / ".aqueduct_calls"
   152	
   153	
   154	def _aq_wait():
   155	    # Cross-process sliding window: block until fewer than AQ_RATE calls in the last 60 s.
   156	    while True:
   157	        with open(AQ_STATE, "a+") as f:
   158	            fcntl.flock(f, fcntl.LOCK_EX)
   159	            f.seek(0)
   160	            now = time.time()
   161	            ts = [float(x) for x in f.read().split() if now - float(x) < 60]
   162	            if len(ts) < AQ_RATE:
   163	                f.seek(0); f.truncate(); f.write("\n".join(map(str, ts + [now])))
   164	                return
   165	            wait = 60 - (now - min(ts)) + 0.1
   166	        time.sleep(wait)
   167	
   168	
   169	def _aqueduct(msgs, model, temperature, max_tokens):
   170	    # TU Wien Aqueduct gateway (AQUEDUCT_BASE_URL / AQUEDUCT_API_KEY in compute.env). Explicit only.
   171	    # Models: qwen-3.8-27b (base Qwen3.8-27B, FP8 = C3 control for the abliterated model), qwen-3.6-35b,
   172	    # glm-5.3-744b-experimental, deepseek-v4-vision-exp-284b.
   173	    env = _env()
   174	    m = model or "qwen-3.8-27b"
   175	    body = {"model": m, "messages": msgs, "temperature": temperature, "max_tokens": max_tokens,
   176	            "chat_template_kwargs": {"enable_thinking": False}}
   177	    for _ in range(8):
   178	        _aq_wait()
   179	        try:
   180	            return _post(f"{env['AQUEDUCT_BASE_URL']}/v1/chat/completions", env["AQUEDUCT_API_KEY"], body, timeout=300), m
   181	        except urllib.error.HTTPError as e:
   182	            if e.code != 429:
