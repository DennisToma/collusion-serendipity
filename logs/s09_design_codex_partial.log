   164	    used = []
   165	    class CachedReplay(ReplayCache):
   166	        def call(self, system, user, tier, backend, run_id, t, agent, attempt, model=None):
   167	            payload = [system, user, tier, backend, TEMPERATURE, run_id, t, agent, attempt]
   168	            if model:
