    12	TEMPERATURE = 1.0
    13	PRICES = list(range(13))
    14	class Cache:
    15	    def __init__(self, path, dry=False):
    16	        self.path, self.dry, self.lock = path, dry, threading.Lock()
    17	        path.parent.mkdir(parents=True, exist_ok=True)
    18	        self.entries = {}
    19	        if path.exists():
    20	            raw = path.read_bytes()
    21	            lines = raw.splitlines(keepends=True)
    22	            offset = 0
    23	            for i, line in enumerate(lines):
    24	                try:
    25	                    row = json.loads(line)
    26	                    self.entries[row['key']] = row['response']
    27	                except (ValueError, KeyError):
    28	                    if i == len(lines) - 1 and not line.endswith(b'\n'):
    29	                        # Preserve evidence and all complete paid responses after a torn append.
    30	                        path.with_suffix(f'.torn.{time.time_ns()}').write_bytes(line)
    31	                        with path.open('r+b') as f:
    32	                            f.truncate(offset)
    33	                        break
    34	                    raise ValueError(f"Damaged cache: {path}")
    35	                offset += len(line)
    36	            else:
    37	                if raw and not raw.endswith(b'\n'):
    38	                    with path.open('ab') as f:
    39	                        f.write(b'\n')
    40	
    41	    def call(self, system, prompt, tier, backend, run_id, t, agent, attempt, model=None):
    42	        payload = [system, prompt, tier, backend, TEMPERATURE, run_id, t, agent, attempt]
    43	        if model:  # Phase 2 part C (explicit seller model); omitted otherwise so older cache keys are unchanged
    44	            payload.append(model)
    45	        # Separate fake and real calls even when reusing the same dataset name.
    46	        key = hashlib.sha256(json.dumps([self.dry, payload]).encode()).hexdigest()
    47	        with self.lock:
    48	            if key in self.entries:
    49	                return self.entries[key]
    50	        if self.dry:
    51	            rng = random.Random(key)
    52	            response = dict(text=json.dumps(dict(public_message="Reviewing market prices.",
    53	                            private_message="I am reviewing prices.", reasoning="dry",
    54	                            quantity=rng.choice(list(map(int, PRICES))))),
    55	                            model="dry", backend="dry")
    56	        else:
    57	            called_utc = datetime.now(timezone.utc).isoformat()
    58	            # glm-5.2 (Go) reasons by default and can spend the 512-token default before answering (empty text)
    59	            extra = dict(max_tokens=4000) if (model or '').startswith('glm') else {}
    60	            for wait in ([30, 60, 120, 240, 300, 300, 300] if backend in ('qwen', 'aqueduct') else []) + [None]:
    61	                try:  # Modal qwen endpoint: cold starts / transient 404-429 -> wait instead of failing the game
    62	                    response = llm.chat(prompt, system=system, tier=tier, backend=backend,
    63	                                        temperature=TEMPERATURE, model=model, **extra)
