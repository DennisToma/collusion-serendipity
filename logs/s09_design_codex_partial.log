def analyze(directory, allow_dry=False):
    directory = Path(directory)
    cfg = json.loads((directory/'config.json').read_text())
    assert cfg['rounds'] == 12 and cfg['n'] == 5 and cfg['seed0'] == SEEDS[0]
    assert cfg['model'] == 'gpt-6-luna' and cfg['backend'] == 'codex'
    assert allow_dry or not cfg['dry'], 'Cannot publish dry data'
    assert set(cfg['sources']) == set(SOURCES), 'Missing/extra frozen source manifest entries'
    assert cfg['version'] == VERSION
    assert not list(directory.glob('failure_*.json')), 'Terminal failed experiment'
    assert not list((directory/'raw').glob('*.torn.*')), 'Torn cache recovery is not publishable'
    if not cfg['dry']:
        import subprocess
        for source,digest in cfg['sources'].items():
            assert hashlib.sha256(subprocess.check_output(['git','show',f"{cfg['registration_commit']}:{source}"])).hexdigest() == digest
    for seed in SEEDS:
        prefix=load_prefix(seed)
        from scripts.s09_snapshot import extract
        assert prefix == extract(seed), 'Prefix differs from original source neutral game'
    assert cfg['transport'] == dict(temporary_directory_root=cfg['transport']['temporary_directory_root'],
                                    sandbox_requested='read-only', no_commands_instruction=True,
                                    filesystem_isolation_attested=False)
    if not cfg['dry']:
        assert cfg['transport']['temporary_directory_root'] == '/var/tmp'
    assert cfg['workers'] == 2 and cfg['deadline_utc'] == DEADLINE
    def setUp(self):
        import shutil
        self.tmp=tempfile.TemporaryDirectory(dir='/var/tmp')
        self.path=Path(self.tmp.name)/'data'
        shutil.copytree(self.original,self.path)

    def tearDown(self):self.tmp.cleanup()

    def analyze(self,**kw):
        from scripts.s09_analyze import analyze
        return analyze(self.path,**kw)

    def test_dry_not_published(self):
        with self.assertRaises(AssertionError):self.analyze()
        self.assertTrue(self.analyze(allow_dry=True)['verification']['cache_only_replay'])

    def test_failure_marker_blocks_analysis_and_resume(self):
        from sim.replay import main
        (self.path/'failure_terminal.json').write_text('{}')
        with self.assertRaises(AssertionError):self.analyze(allow_dry=True)
        with patch('sys.argv',['sim.replay','--dry','--out',str(self.path)]), self.assertRaises(RuntimeError):main()

    def test_mutated_action_rejected(self):
        p=next(self.path.glob('game_*.json'));obj=json.loads(p.read_text())
        obj['rows'][6]['agents'][0]['quantity']=(obj['rows'][6]['agents'][0]['quantity']+1)%13
        p.write_text(json.dumps(obj))
        with self.assertRaises((AssertionError,ValueError)):self.analyze(allow_dry=True)

    def test_raw_mutation_rejected(self):
        p=self.path/'raw/responses.jsonl';rows=[json.loads(x) for x in p.read_text().splitlines()]
        rows[0]['response']['text']='{}';p.write_text(''.join(json.dumps(x)+'\n' for x in rows))
        with self.assertRaises(AssertionError):self.analyze(allow_dry=True)

    def test_duplicate_key_rejected(self):
        p=self.path/'raw/responses.jsonl';first=p.read_text().splitlines()[0]
        with p.open('a') as f:f.write(first+'\n')
        with self.assertRaises(AssertionError):self.analyze(allow_dry=True)

